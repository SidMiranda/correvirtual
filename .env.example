# Credenciais de bootstrap do container Postgres (docker-compose lê este arquivo
# automaticamente por estar na raiz, ao lado do docker-compose.yml).
#
# IMPORTANTE: estes três valores precisam ser IDÊNTICOS a DB_DATABASE / DB_USERNAME /
# DB_PASSWORD em src/.env — é a mesma credencial vista por dois lados (o container do
# Postgres que a cria, e o Laravel que conecta nela). Veja docs/runbook.md.
#
# Uso local: copie para ".env" (`cp .env.example .env`) e ajuste se quiser.
# Em produção: o workflow .github/workflows/deploy.yml gera este arquivo sozinho,
# extraindo os mesmos valores de src/.env — não precisa copiar manualmente no servidor.

POSTGRES_DB=corre_virtual
POSTGRES_USER=corre_virtual
POSTGRES_PASSWORD=corre_virtual_dev
